rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════
    // Every session is minted by /api/line-auth, which issues a custom
    // token whose uid IS the user's document id — the same id on every
    // device. That is what makes these rules possible.
    //
    // The previous ruleset allowed any signed-in caller to read and write
    // everything, because signInAnonymously() handed out a fresh uid each
    // time storage was lost and request.auth.uid could not be matched to
    // an owner. Anyone could sign in anonymously with the public web API
    // key and read every patient's records.
    // ══════════════════════════════════════════════════════════════

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid in [
        'PJWosepqPObqnE1geMWz5k6qEmy2',
        'dpvAjGd6ScSJdVptiOyYD0JkGui1'
      ];
    }

    // A document belongs to the caller when its uid field says so.
    function owns(data) {
      return signedIn() && data.uid is string && data.uid == request.auth.uid;
    }

    // Collections of personal records, all keyed by a uid field. Reads have
    // to be filtered by uid, which every page query already does.
    function personal() {
      return [
        'foodLogs', 'exerciseLogs', 'healthLogs', 'bodyStats', 'reminders',
        'missionCompletions', 'redemptions', 'transactions',
        'dailyCalorieSummaries', 'dailyExerciseSummaries', 'calorieNotifications'
      ];
    }

    // Phone number, birth date, body measurements — owner and admin only.
    match /users/{userId} {
      allow read:   if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Public projection of users/: display name, avatar and points, nothing
    // else. Ranking reads this so that users/ can stay private.
    match /leaderboard/{userId} {
      allow read:  if signedIn();
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Catalogue data — everyone reads, only admins edit.
    match /missions/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    match /rewards/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // Personal records. An unlisted collection matches nothing above and
    // nothing here, so it is denied by default.
    match /{collection}/{docId} {
      allow read:   if collection in personal() && (owns(resource.data) || isAdmin());
      allow create: if collection in personal() && owns(request.resource.data);
      allow update: if collection in personal() && owns(resource.data) && owns(request.resource.data);
      allow delete: if collection in personal() && (owns(resource.data) || isAdmin());
    }
  }
}
